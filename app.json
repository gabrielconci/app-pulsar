{
  "expo": {
    "name": "Pulsar",
    "slug": "pulsar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pulsar.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "pulsar",
    "platforms": [
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Pulsar precisa acessar suas fotos e vídeos para você publicar no seu portfólio.",
          "cameraPermission": "O Pulsar precisa da câmera para você tirar sua foto de perfil."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}